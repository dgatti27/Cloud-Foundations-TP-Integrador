# =============================================================================
# terraform.tfvars.example — Plantilla de valores locales
# -----------------------------------------------------------------------------
# Copiar y ajustar (el .tfvars real está en .gitignore — no subir secrets):
#   Copy-Item terraform.tfvars.example terraform.tfvars
#
# Todo lo no seteado usa el default de variables.tf.
# =============================================================================

region              = "us-east-1"
localstack_endpoint = "http://localhost:4566" # IAM/STS
minio_endpoint      = "http://localhost:9000" # buckets *-data-raw

# Credenciales dummy LocalStack (compose / awslocal)
# aws_access_key = "test"
# aws_secret_key = "test"

# Credenciales MinIO (= MINIO_ROOT_* del compose)
# minio_access_key = "minioadmin"
# minio_secret_key = "minioadmin"

# Si los buckets *-data-raw ya existen (creados a mano / Python):
# manage_minio_buckets = false

# manage_minio_buckets = true
# upload_seed_object   = true

