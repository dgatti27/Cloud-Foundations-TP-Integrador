region = "us-east-1"

# Hobby / sin cuenta AWS: solo inventario + checks (DEFAULT)
create_budget  = false
use_localstack = false

# Techo TP (debe coincidir con finops/budget.json)
# budget_name   = "tp-integrador-monthly-budget"
# budget_amount = "300"

# Mail del grupo (obligatorio si create_budget=true)
# notify_email = "tu-grupo@universidad.edu"

# AWS real / Learner Lab:
# create_budget  = true
# use_localstack = false
# + AWS_PROFILE o AWS_ACCESS_KEY_ID en el entorno (no los pongas acá)

# LocalStack Pro (Hobby Community falla):
# create_budget  = true
# use_localstack = true

# tags = {
#   Project = "TP-Integrador"
#   Lab     = "10-tp"
# }
