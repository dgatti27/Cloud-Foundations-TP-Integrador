# Build context exclusions — la imagen NO debe llevar secretos ni state mutable.
# Vive en la raíz porque el context del toolbox es `.` (ver docker/Dockerfile).
.git
.github
.ruff_cache
.pytest_cache
**/__pycache__
**/*.py[cod]
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/.terraform.tfstate.lock.info
**/*.tfvars
!**/*.tfvars.example
.env
.env.*
!.env.example

# Airflow logs — mount en runtime. Evita symlinks Windows en el build.
apps/airflow/logs/
labs/

# Docs / assets pesados no requeridos para aplicar IaC
assets/
docs/img/
**/*.png
**/*.jpg

# IDE / OS
.cursor
.vscode
.DS_Store
**/Thumbs.db
