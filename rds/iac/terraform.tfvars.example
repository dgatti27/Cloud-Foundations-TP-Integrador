# =============================================================================
# terraform.tfvars.example — Plantilla de valores locales
# -----------------------------------------------------------------------------
# Copiar (el .tfvars real está en .gitignore):
#   Copy-Item terraform.tfvars.example terraform.tfvars
# =============================================================================

region              = "us-east-1"
localstack_endpoint = "http://localhost:4566" # VPC / sg-rds lookup
ministack_endpoint  = "http://localhost:4567" # RDS + Secrets DB
minio_endpoint      = "http://localhost:9000" # snapshot-data-lake

# Credenciales dummy LocalStack/MiniStack
# aws_access_key = "test"
# aws_secret_key = "test"

# Credenciales MinIO (= MINIO_ROOT_* del compose)
# minio_access_key = "minioadmin"
# minio_secret_key = "minioadmin"

# Lookup lab 07-v2 (debe existir antes del apply)
# vpc_name_tag    = "tp-integrador-vpc"
# subnet_role_tag = "rds"
# sg_rds_name_tag = "sg-rds"

# Instancia (defaults = rds_tp_config.json / to-be TP)
# db_identifier     = "tp-dw-db"
# instance_class    = "db.t3.medium"
# allocated_storage = 50
# multi_az          = true

# Si el bucket snapshot NO existe aún (s3/iac no corrido):
# manage_snapshot_bucket = true

# Si preferís seed solo vía Python:
# apply_rds_seed = false

# Si apps Compose ven otro hostname que el address MiniStack:
# rds_host_override = "host.docker.internal"

# tags = {
#   Project = "TP-Integrador"
#   Lab     = "08-tp"
# }
