# =============================================================================
# terraform.tfvars.example — Plantilla (copiar a terraform.tfvars)
# -----------------------------------------------------------------------------
# terraform.tfvars NO se commitea (.gitignore). Este .example SÍ.
#
#   Copy-Item terraform.tfvars.example terraform.tfvars
# =============================================================================

# Región → AZs us-east-1a / us-east-1b
region = "us-east-1"

# LocalStack del compose
localstack_endpoint = "http://localhost:4566"

# Credenciales Hobby — descomentar si no usás defaults de variables.tf
# aws_access_key = "test"
# aws_secret_key = "test"

# Espacio de direcciones de la VPC (subnets /24 adentro)
vpc_cidr = "10.0.0.0/16"

# true = NAT + ruta compute→Internet; false = omitir NAT (LocalStack flaky / ahorro)
enable_nat = true

# true = escribe ../vpc_config.json para demos RDS/Lambda/ECS
write_vpc_config = true

tags = {
  Project = "TP-Integrador"
  Lab     = "07-v2"
}
