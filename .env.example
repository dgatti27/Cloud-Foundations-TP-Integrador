# Copiá a .env en la raíz:  cp .env.example .env   (PowerShell: Copy-Item .env.example .env)
# Compose lee este archivo automáticamente.

# Obligatorio — token LocalStack Hobby (https://app.localstack.cloud)
LOCALSTACK_AUTH_TOKEN=

# Credenciales dummy locales (LocalStack / MiniStack / AWS CLI)
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# MinIO (data lake :9000 / consola :9001)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Postgres orígenes Compose (no son la RDS MiniStack)
# postgres-dw = metastore Airflow (DB name histórica "gold"); RDS dw es otra cosa.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB_BRONCE=bronce
POSTGRES_DB_DW=gold
POSTGRES_DB_ERP=erp

# pgAdmin :5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
