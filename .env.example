# Copiá a `.env` en la raíz del repo (no se sube a git).
# Requerido por compose.yaml para LocalStack Hobby.

LOCALSTACK_AUTH_TOKEN=reemplazar-con-tu-token-hobby
AWS_DEFAULT_REGION=us-east-1
